{
  // Read by the release tools in systemfsoftware/pnpm-release-management.
  // Each package is versioned through its change intents, tagged <pkg>@vX.Y.Z
  // and released on GitHub, and published to npm through trusted publishing.
  "base": "main",
  "branch": "changeset-release/main",
  "versioning": {
    "strategy": "changesets",
  },
  // A pull request whose head moves a publishable package's turbo `build` hash
  // away from the base ships an intent naming that package.
  "gate": { "strategy": "turbo", "task": "build" },
}
